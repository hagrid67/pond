[Unit]
Description=Submit random pond update sample from gcweb1
After=network-online.target pond-web-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/pond
ExecStartPre=/usr/bin/env bash -lc 'sleep "$((RANDOM % 1201 + 600))"'
ExecStart=%h/projects/pond/ve311pond/bin/python %h/projects/pond/pond/apitest.py --url http://127.0.0.1:9000/api/pondupdate

[Install]
WantedBy=default.target
