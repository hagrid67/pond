[Unit]
Description=Regenerate pond temperature chart
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/heating/dev/notebooks
Environment="PATH=%h/projects/heating/dev/ve311/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/projects/heating/dev/ve311/bin/jupyter execute run-plot.ipynb
ExecStartPost=/usr/bin/ls -lrt %h/projects/heating/dev/www-root/pond-temps.png

[Install]
WantedBy=default.target