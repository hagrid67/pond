[Unit]
Description=Retry forwarding queued pond submissions from gcweb1 to jwpc12
After=network-online.target pond-submit-edge.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/pond
Environment=POND_EDGE_QUEUE_DB=%h/projects/pond/data/submit-edge.sqlite
Environment=POND_FORWARD_URL=https://jwpc12.example.net/internal-api/ingest
Environment=POND_FORWARD_SHARED_SECRET=change-me
ExecStart=/usr/bin/env python3 -m pond.submit_forwarder --once

[Install]
WantedBy=default.target